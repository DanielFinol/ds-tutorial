---
import '../styles/global.css';
import { AUTHOR, LANGS, ui, type Lang } from '../lib/i18n';
import { switchLang, url } from '../lib/paths';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
  lesson?: string;
}
const { title, lang = 'en', lesson } = Astro.props;
const t = ui[lang];
const description = Astro.props.description ?? t.description;
const fullTitle = title === t.site ? title : `${title} · ${t.site}`;
const others = LANGS.filter((l) => l !== lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f6f5c" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icons/icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(Astro.url.pathname, l), Astro.site)} />)}
    <script src="../lib/pwa.ts"></script>
  </head>
  <body data-lesson={lesson}>
    <div class="author-bar">
      <div class="wrap">
        <a class="author-link" href={AUTHOR.url} title={t.authorLink}>
          <span class="author-by">{t.byline}</span> <strong>{AUTHOR.name}</strong><span class="author-role"> · {t.authorRole}</span>
          <span class="author-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('', lang)}>{t.brand[0]} <span>{t.brand[1]}</span></a>
        <nav>
          <a href={url('', lang)}>{t.lessons}</a>
          {others.map((l) => <a class="lang-switch" href={switchLang(Astro.url.pathname, l)} hreflang={l} lang={l}>{ui[l].langName}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">{t.footer}</div>
    </footer>
  </body>
</html>
