---
import '../styles/global.css';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  lesson?: string;
}
const SITE = 'Data Science at Work';
const {
  title,
  description = 'Hands-on practice in the day-to-day skills of a working data scientist. Real Python and SQL, in your browser.',
  lesson,
} = Astro.props;
const fullTitle = title === SITE ? title : `${title} · ${SITE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f6f5c" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icons/icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <script src="../lib/pwa.ts"></script>
  </head>
  <body data-lesson={lesson}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}>Data Science <span>at Work</span></a>
        <nav><a href={url()}>Lessons</a></nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        All code runs locally in your browser (Python via Pyodide, SQL via DuckDB): no server, no sign-up. Your work is saved in this browser. Works offline after your first visit.
      </div>
    </footer>
  </body>
</html>
