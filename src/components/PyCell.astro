---
/**
 * An editable, runnable code cell.
 *   <PyCell code={`print("hi")`} />
 *   <PyCell code={`x = ...`} check={`assert x == 42, "x should be 42"`} solution={`x = 42`} hint="Use `6 * 7`." />
 *   <PyCell lang="sql" code={`SELECT 1`} />   // runs in DuckDB; the DataFrame is stored in `result`
 */
interface Props {
  code: string;
  check?: string;
  solution?: string;
  hint?: string;
  title?: string;
  lang?: 'python' | 'sql';
}
const { code, check, solution, hint, title, lang = 'python' } = Astro.props;
const trim = (s?: string) => s?.replace(/^\n+|\s+$/g, '');
const source = trim(code)!;
const isExercise = Boolean(check);
const label = title ?? (isExercise ? 'Exercise' : lang === 'sql' ? 'SQL' : 'Python');
// `inline code` in hints
const hintParts = hint?.split(/(`[^`]+`)/g) ?? [];
---

<py-cell
  class:list={['cell', { exercise: isExercise }]}
  data-lang={lang}
  data-check={trim(check)}
  data-solution={trim(solution)}
  data-initial={source}
>
  <div class="cell-head">
    <span class="cell-title">{label}<span class="cell-done" aria-label="solved"> ✓</span></span>
    <div class="cell-actions">
      <button type="button" class="btn-ghost" data-reset>Reset</button>
      <button type="button" class="btn" data-run>Run ▶</button>
    </div>
  </div>
  <div class="cell-editor"><pre class="cell-fallback">{source}</pre></div>
  {
    (hint || solution) && (
      <div class="cell-help">
        {hint && (
          <details>
            <summary>Hint</summary>
            <p>{hintParts.map((p) => (p.startsWith('`') ? <code>{p.slice(1, -1)}</code> : p))}</p>
          </details>
        )}
        {solution && (
          <details>
            <summary>Solution</summary>
            <pre class="cell-solution">{trim(solution)}</pre>
            <button type="button" class="btn-ghost" data-use-solution>Copy into editor</button>
          </details>
        )}
      </div>
    )
  }
  <div class="cell-out" aria-live="polite" hidden></div>
</py-cell>

<script>
  import '../lib/cell';
</script>
