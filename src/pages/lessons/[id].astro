---
import LessonPage from '../../components/LessonPage.astro';
import { getLessons, slugOf } from '../../lib/lessons';

export async function getStaticPaths() {
  const lessons = await getLessons('en');
  return lessons.map((lesson, i) => ({
    params: { id: slugOf(lesson) },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
---

<LessonPage lang="en" lesson={lesson} prev={prev} next={next} />
