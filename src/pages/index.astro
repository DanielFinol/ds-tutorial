---
import Base from '../layouts/Base.astro';
import { getLessons, groupByModule } from '../lib/lessons';
import { url } from '../lib/paths';

const lessons = await getLessons();
const modules = groupByModule(lessons);
const ready = lessons.filter((l) => l.data.status === 'ready');
const hours = Math.round(ready.reduce((s, l) => s + l.data.minutes, 0) / 60);
---

<Base title="Data Science at Work">
  <h1>Data Science at Work</h1>
  <p class="lede">
    You know the theory. This is the practice: {ready.length} hands-on lessons (about {hours} hours) in the tools and
    habits a data scientist uses in today's workplace. Every lesson is a series of real tasks on one company's data, run
    and checked right here in your browser.
  </p>
  <p>
    <a class="btn" href={url(`lessons/${ready[0].id}/`)} style="text-decoration:none" data-start>Start →</a>
    <span class="progress-note" data-progress></span>
  </p>

  {
    modules.map(([name, items]) => (
      <section class="module">
        <h2>{name}</h2>
        <ul class="lesson-list">
          {items.map((l) =>
            l.data.status === 'ready' ? (
              <li>
                <a class="lesson-card" href={url(`lessons/${l.id}/`)} data-lesson={l.id}>
                  <span class="num">{l.data.order}</span>
                  <div>
                    <h3>{l.data.title}</h3>
                    <p>{l.data.description}</p>
                    <p class="tools">{l.data.tools.join(' · ')} · {l.data.minutes} min</p>
                  </div>
                </a>
              </li>
            ) : null,
          )}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  import { getCompleted } from '../lib/progress';
  const done = getCompleted();
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-lesson]')];
  for (const el of cards) {
    if (done.has(el.dataset.lesson!)) {
      el.classList.add('done');
      el.querySelector('.num')!.textContent = '✓';
    }
  }
  const n = cards.filter((c) => c.classList.contains('done')).length;
  if (n) {
    document.querySelector('[data-progress]')!.textContent = ` ${n} of ${cards.length} lessons complete`;
    const next = cards.find((c) => !c.classList.contains('done'));
    const start = document.querySelector<HTMLAnchorElement>('[data-start]')!;
    if (next) {
      start.href = next.href;
      start.textContent = 'Continue →';
    }
  }
</script>
