{
  "name": "ds-tutorial",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Data Science at Work: an interactive, exercise-driven tutorial that runs in the browser.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "i18n": "node scripts/i18n.mjs",
    "dev": "node scripts/i18n.mjs && astro dev",
    "build": "node scripts/i18n.mjs && astro check && astro build",
    "preview": "astro preview",
    "check": "node scripts/i18n.mjs && astro check",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "astro": "7.4.12",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
